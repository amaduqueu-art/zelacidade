{
  "name": "zelacidade",
  "version": "1.0.0",
  "private": true,
  "description": "ZelaCidade — cidadania e zeladoria urbana. Relate, apoie e acompanhe problemas da sua cidade.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx serve@14 out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cf:login": "npx --yes wrangler@4 login",
    "deploy": "npm run build && npx --yes wrangler@4 pages deploy out --project-name zelacidade",
    "deploy:preview": "npm run build && npx --yes wrangler@4 pages deploy out --project-name zelacidade --branch preview"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "@supabase/supabase-js": "2.45.4",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.441.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "1.5.0",
    "tailwind-merge": "2.5.2",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "8.4.41",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=18.17"
  }
}
